    "gen:api": "openapi-typescript ../openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@mantine/charts": "9.7.5",
    "@mantine/core": "9.7.5",
    "@mantine/dates": "9.7.5",
    "@mantine/form": "9.7.5",
    "@mantine/hooks": "9.7.5",
    "@mantine/notifications": "9.7.5",
    "@tabler/icons-react": "3.50.0",
    "@tanstack/react-query": "5.107.1",
    "dayjs": "1.11.23",
    "mantine-form-zod-resolver": "1.3.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "recharts": "3.10.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.32",
    "postcss-preset-mantine": "1.18.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
